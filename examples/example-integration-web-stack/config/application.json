{
  "gin": {
    "enabled": true,
    "host": "0.0.0.0",
    "port": 8080,
    "mode": "debug",
    "enable_recover": true,
    "enable_logger": true
  },
  "zerolog": {
    "enabled": true,
    "level": "info",
    "format": "console",
    "output": "stdout"
  },
  "prometheus": {
    "enabled": true,
    "host": "0.0.0.0",
    "port": 9090,
    "path": "/metrics"
  },
  "cron": {
    "enabled": true,
    "with_logger": true
  },
  "validator": {
    "enabled": true,
    "enable_custom_validators": true
  },
  "swagger": {
    "enabled": true,
    "host": "localhost:8080",
    "port": 8080,
    "url": "/swagger/doc.json",
    "title": "Web Stack API"
  }
}