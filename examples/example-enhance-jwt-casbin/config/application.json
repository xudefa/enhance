{
  "enhance": {
    "debug": true
  },
  "server": {
    "host": "0.0.0.0",
    "port": 8080
  },
  "security": {
    "enabled": true,
    "jwt": {
      "enabled": true,
      "secret-key": "my-secret-key-for-jwt-authentication",
      "expiration": 3600,
      "exclude-paths": "/login,/register,/public/**"
    },
    "casbin": {
      "enabled": true,
      "model-type": "file",
      "model-path": "config/casbin_model.conf",
      "policy-type": "file",
      "policy-path": "config/casbin_policy.csv"
    },
    "rules": "/public/**->permitAll,/login->permitAll,/api/admin/**->hasRole('ADMIN'),/api/**->authenticated"
  }
}