{
  "app": {
    "name": "kafka-otel-demo",
    "version": "1.0.0"
  },
  "redis": {
    "host": "localhost",
    "port": 6379,
    "password": "",
    "db": 0,
    "prefix": "demo:",
    "pool_size": 10
  },
  "kafka": {
    "brokers": ["localhost:9092"],
    "topic": "demo-events",
    "group_id": "demo-consumer"
  },
  "otel": {
    "enabled": true,
    "endpoint": "localhost:4317",
    "service_name": "demo-service",
    "service_version": "1.0.0",
    "sampling_rate": 1.0
  },
  "log": {
    "type": "zap",
    "level": "debug",
    "format": "json",
    "development": true
  }
}